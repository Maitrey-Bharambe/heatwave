# Supabase project (Project Settings → API Keys)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Secret key (sb_secret_...): server-only, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""

# Random secret (>= 32 chars) used to HMAC session tokens. Generate: openssl rand -base64 32
SESSION_SECRET=""
