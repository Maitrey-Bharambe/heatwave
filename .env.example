# ── Supabase (Project → Connect → ORMs → Prisma) ──────────────────────────────
# App connection: Transaction pooler, port 6543. Keep ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations: Session pooler / direct connection, port 5432
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# Random secret (>= 32 chars) used to HMAC session tokens. Generate: openssl rand -base64 32
SESSION_SECRET=""

# Local PostgreSQL instead of Supabase: set both URLs to the same local database, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/climateiq?schema=public"
# DIRECT_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/climateiq?schema=public"

# Supabase project API keys (optional — the app's database access uses the URLs above)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
