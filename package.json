{
  "name": "climateiq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ClimateIQ — Climate Intelligence & Heatwave Early Warning System for India",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "db:start": "\"C:/Program Files/PostgreSQL/18/bin/pg_ctl.exe\" -D .pgdata -o \"-p 5544\" -l .pgdata/server.log start",
    "db:stop": "\"C:/Program Files/PostgreSQL/18/bin/pg_ctl.exe\" -D .pgdata stop -m fast",
    "test": "node --test tests/heatRisk.test.mjs",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "db:supabase-sql": "node scripts/generate-supabase-sql.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^1.50.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
